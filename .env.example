# NephrosPaidi Environment Configuration
# Copy this file to .env and adjust values for your environment

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=nephros_user
DB_PASSWORD=nephros_pass

# Eureka Configuration
EUREKA_URL=http://localhost:8761/eureka

# Keycloak Configuration
KEYCLOAK_URL=http://localhost:8080/realms/nephrospaidi

# Full stack compose settings
COMPOSE_PROJECT_NAME=nephropaidi

# Optional: lower build concurrency to reduce CPU spikes
# COMPOSE_PARALLEL_LIMIT=2

# Dockerized Config Server URI override (if needed)
SPRING_CLOUD_CONFIG_URI=http://config-server:8888

# WhatsApp / Twilio for procedure-service
TWILIO_WHATSAPP_ENABLED=false
TWILIO_WHATSAPP_ACCOUNT_SID=
TWILIO_WHATSAPP_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_DEFAULT_RECIPIENT=whatsapp:+21600000000
# Optional override
# TWILIO_WHATSAPP_API_BASE_URL=https://api.twilio.com

# Optional DB override for core-ops-service
# CORE_OPS_DB_URL=jdbc:postgresql://ep-cool-breeze-agqhhjlc.c-2.eu-central-1.aws.neon.tech/nephros_core_ops_service_db?sslmode=require&channel_binding=require
# Optional: Override individual service databases
# USER_SERVICE_DB=nephros_user_service_db
# OPS_SERVICE_DB=nephros_ops_service_db
# PATIENT_SERVICE_DB=nephros_patient_service_db
# CLINICAL_SERVICE_DB=nephros_clinical_service.db
# PHARMACY_SERVICE_DB=nephros_pharmacy_service_db
# PROCEDURE_SERVICE_DB=nephros_procedure_service_db
# COMMUNICATION_SERVICE_DB=nephros_communication_service_db
# CORE_OPS_SERVICE_DB=nephros_core_ops_service_db
